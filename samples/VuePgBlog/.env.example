# Copy to .env. Keep credentials out of source control.
DATABASE_URL=postgresql://vue_inertia:local-dev-password@localhost:5433/vue_inertia
POSTGRES_DB=vue_inertia
POSTGRES_USER=vue_inertia
POSTGRES_PASSWORD=local-dev-password
POSTGRES_PORT=5433
APP_NAME=Inkwell
APP_BASE_URL=http://localhost:5199
DATA_DIR=storage
ANALYTICS_SALT=local-dev-salt

# External S3-compatible storage. Leave empty to run without uploads.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_BACKUP_BUCKET=

EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Inkwell

# Optional services; folder/environment namespaces are enforced by the application.
SEARCH_DRIVER=native
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
REDIS_URL=

# Exact posts index UID; blank uses <sample>-<environment>-posts.
MEILISEARCH_INDEX=

# TickerQ runs all schedules in UTC.
CRON_ENABLED=true
# CRON_BACKUP= (overrides Cron:backup)
# CRON_RECOMMENDATION_DIGEST= (overrides Cron:recommendation-digest)
# CRON_SEARCH_RECONCILE= (overrides Cron:search-reconcile)
# CRON_INTEREST_PROFILES= (overrides Cron:interest-profiles)
