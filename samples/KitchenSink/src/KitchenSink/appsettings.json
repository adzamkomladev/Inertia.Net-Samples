{
  "App": {
    "Name": "Inertia Kitchen Sink",
    "DataDir": "App_Data"
  },
  "Demo": {
    "QueryMethod": true,
    "GlobalRateLimit": true,
    "GlobalRateLimitPerMinute": 120,
    "PartialRateLimit": 600,
    "DailyReset": true,
    "DailyResetHourUtc": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
