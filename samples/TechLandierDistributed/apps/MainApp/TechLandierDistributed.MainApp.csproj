<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TechLandierDistributed.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../lib/TechLandier.Core/TechLandier.Core.csproj" />
    <ProjectReference Include="../../lib/TechLandier.Caching/TechLandier.Caching.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="Inertia.Net" Version="1.5.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Frontend source/tooling is built by bun, not by MSBuild. -->
    <Content Remove="ClientApp/**;node_modules/**;ssr/**;package.json;bun.lock;tsconfig.json;components.json" />
    <None Remove="ClientApp/**;node_modules/**;ssr/**" />
    <!-- Local secrets never ship in the publish output. -->
    <Content Remove=".env;.env.*;**/.env;**/.env.*" />
    <None Remove=".env;.env.*;**/.env;**/.env.*" />
  </ItemGroup>

</Project>
