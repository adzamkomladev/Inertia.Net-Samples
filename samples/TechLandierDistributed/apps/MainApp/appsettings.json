{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "Name": "TechLandier",
    "BaseUrl": "",
    "DataDir": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Replicas": {
    "Enabled": true,
    "Namespace": "TechLandierDistributed:development"
  },
  "Redis": {
    "Url": ""
  },
  "Cache": {
    "RedisUrl": "",
    "Version": "v1",
    "MaxEntryBytes": 1048576
  },
  "Inertia": {
    "Ssr": true,
    "SsrUrls": [],
    "SsrTimeoutSeconds": 2,
    "SsrCacheSeconds": 300,
    "SsrStaleSeconds": 60,
    "SsrMaxActive": 2,
    "SsrMaxQueued": 8,
    "SsrFailureThreshold": 2
  },
  "Jobs": {
    "Concurrency": 4,
    "Enabled": false
  },
  "Cron": {
    "Enabled": false
  },
  "Storage": {
    "ServiceUrl": "",
    "Region": "us-east-1",
    "Bucket": "uploads",
    "AccessKey": "",
    "SecretKey": "",
    "PublicBaseUrl": ""
  },
  "Maileroo": {
    "ApiKey": "",
    "From": "",
    "FromName": "TechLandier"
  }
}
