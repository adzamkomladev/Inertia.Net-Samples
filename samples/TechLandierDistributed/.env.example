# Copy to .env. Keep credentials out of source control.
# Host development uses PgDog on 5443; Compose replaces these with container hostnames.
DATABASE_URL=Host=localhost;Port=5443;Database=techlandier;Username=techlandier;Password=local-dev-password;Options=-c pgdog.role=primary;Maximum Pool Size=10
DATABASE_READ_URL=Host=localhost;Port=5443;Database=techlandier;Username=techlandier;Password=local-dev-password;Options=-c pgdog.role=replica;Maximum Pool Size=5
DATABASE_MIGRATE_URL=Host=localhost;Port=5442;Database=techlandier;Username=techlandier;Password=local-dev-password;Maximum Pool Size=5
POSTGRES_PASSWORD=local-dev-password
REPLICATOR_PASSWORD=local-replication-password
POSTGRES_PORT=5442
PGDOG_PORT=5443
PGDOG_METRICS_PORT=9090

APP_BASE_URL=http://localhost:8185
ANALYTICS_SALT=local-dev-salt

# Shared state. Critical Redis holds Data Protection keys, SignalR and rate limits; cache Redis is disposable.
REDIS_URL=redis://localhost:6389
CACHE_REDIS_URL=redis://localhost:6390
REPLICA_NAMESPACE=TechLandierDistributed:local
CACHE_VERSION=v1
AUTH_SECURE_COOKIES=false

# S3-compatible object storage for uploads; keep the backup bucket private.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=uploads

EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
