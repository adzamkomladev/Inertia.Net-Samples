{
  "name": "sveltemongoblog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "svelte-check --tsconfig ./tsconfig.json --threshold error && bun --bun vite build && bun --bun vite build --ssr ClientApp/ssr.ts",
    "check:ssr": "bun --bun scripts/check-ssr-dev.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error"
  },
  "dependencies": {
    "@inertiajs/svelte": "^3.9.1",
    "@inertiajs/vite": "^3.9.1",
    "@lucide/svelte": "^1.54.0",
    "@microsoft/signalr": "^10.0.11",
    "@unovis/ts": "^1.7.1",
    "bits-ui": "^2.19.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "svelte": "^5.57.2",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.3"
  }
}
