<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="TickerQ" Version="10.4.0" />
    <Compile Remove="Data/Migrations/**/*.cs" />
    <Content Include="app.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Frontend source/tooling is built by bun, not by MSBuild. -->
    <Content Remove="ClientApp/**;node_modules/**;ssr/**;package.json;bun.lock;tsconfig.json;svelte.config.js" />
    <None Remove="ClientApp/**;node_modules/**;ssr/**" />
    <!-- Local secrets never ship in the publish output. -->
    <Content Remove=".env;.env.*;**/.env;**/.env.*" />
    <None Remove=".env;.env.*;**/.env;**/.env.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.1" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="Inertia.Net" Version="1.0.3" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
  </ItemGroup>

</Project>
