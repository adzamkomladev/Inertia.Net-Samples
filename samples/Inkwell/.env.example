# Copy to .env in this sample directory. Existing process variables take precedence.
# Plain environment names are preferred; legacy ASP.NET section names also work. Never put secrets in VITE_ variables.
# For Docker use Data Source=/data/app.db so the database stays on the persistent volume.
DATABASE_URL="Data Source=App_Data/app.db;Default Timeout=30;Foreign Keys=True"
DATA_PROTECTION_KEYS_PATH=App_Data/keys
APP_BASE_URL=http://localhost:5100
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=media
S3_BACKUP_BUCKET=backups
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
ANALYTICS_SALT=local-dev-salt
