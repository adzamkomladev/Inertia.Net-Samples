<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>$(WarningsAsErrors);CS4014;CS1998</WarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Inkwell</RootNamespace>
    <UserSecretsId>inkwell</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.1" />
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="Inertia.Net" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="TickerQ" Version="10.4.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Inkwell.Tests" />
  </ItemGroup>

  <!-- The frontend is built separately (npm run build); dotnet build never needs Node. -->
  <ItemGroup>
    <Content Remove=".env;.env.*;**/.env;**/.env.*" />
    <None Remove=".env;.env.*;**/.env;**/.env.*" />
    <Content Remove="node_modules\**;ClientApp\**;ssr\**;package*.json;tsconfig*.json;components.json" />
    <None Remove="node_modules\**;ClientApp\**;ssr\**" />
    <None Update="app.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
