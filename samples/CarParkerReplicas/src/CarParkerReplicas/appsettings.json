{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "Name": "CarParker",
    "BaseUrl": "",
    "DataDir": ""
  },
  "Inertia": { "Ssr": true },
  "Jobs": { "Concurrency": 4 },
  "Database": { "InitializeOnStartup": true },
  "Replicas": {
    "Enabled": true,
    "Namespace": ""
  },
  "Cache": {
    "Version": "v1",
    "MaxEntryBytes": 0,
    "TagTtlPaddingSeconds": 60,
    "FailureLogSeconds": 30
  },
  "Storage": {
    "ServiceUrl": "",
    "Region": "us-east-1",
    "Bucket": "uploads",
    "AccessKey": "",
    "SecretKey": "",
    "PublicBaseUrl": ""
  },
  "Maileroo": {
    "ApiKey": "",
    "From": "",
    "FromName": "CarParker"
  }
}
