# Copy to .env; actual environment variables override these values.
APP_BASE_URL=http://localhost:8184
ANALYTICS_SALT=local-dev-salt

# MongoDB. Local development uses the single-node replica set in docker-compose.dev.yml.
# The production Compose stack uses mongo1/mongo2/mongo3 (see docker-compose.yml).
DATABASE_URL="mongodb://localhost:27018/?replicaSet=rs0&directConnection=true"
DATABASE_NAME=carparker_replicas
MONGO_MODE=replica

# Shared Redis: Data Protection key ring, SignalR backplane, rate limits and the Inertia cache.
# Leave empty only for a single-process deployment without replicas.
REDIS_URL=redis://localhost:6388
REDIS_URL_DOCKER=redis://redis:6379
# Empty uses CarParkerReplicas:<environment>; set an explicit unique name in production.
REPLICA_NAMESPACE=
CACHE_VERSION=v1
AUTH_SECURE_COOKIES=false

# Compose ports (local only).
APP_PORT=8184
MONGO_PORT=27018
REDIS_PORT=6388

# S3-compatible storage is external; provide its endpoint and credentials here.
S3_ENDPOINT=
S3_BUCKET=uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email (Maileroo). Empty API key logs email payloads only in Development.
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=CarParker
