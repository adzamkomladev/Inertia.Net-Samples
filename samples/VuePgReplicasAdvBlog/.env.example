# Copy to .env. Keep credentials out of source control.
DATABASE_URL=postgresql://vue_pg_replicas_adv_blog:local-dev-password@localhost:5441/vue_pg_replicas_adv_blog
POSTGRES_DB=vue_pg_replicas_adv_blog
POSTGRES_USER=vue_pg_replicas_adv_blog
POSTGRES_PASSWORD=local-dev-password
POSTGRES_PORT=5441
REDIS_PORT=6387
APP_PORT=8183
APP_BASE_URL_DOCKER=http://localhost:8183
REPLICA_NAMESPACE=VuePgReplicasAdvBlog:production
SECURE_COOKIES=false
APP_NAME=Inkwell
APP_BASE_URL=http://localhost:8183
DATA_DIR=storage
ANALYTICS_SALT=local-dev-salt

# External S3-compatible storage. Leave empty to run without uploads.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_BACKUP_BUCKET=

EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Inkwell

# Redis is REQUIRED; Docker uses REDIS_URL_DOCKER when set, otherwise its local service.
REDIS_URL=redis://127.0.0.1:6387
# Set to your external Redis URL to use the same service from app containers.
REDIS_URL_DOCKER=
# Optional search service; folder/environment namespaces are enforced by the application.
SEARCH_DRIVER=native
MEILISEARCH_URL=
MEILISEARCH_API_KEY=

# Exact posts index UID; blank uses <sample>-<environment>-posts.
MEILISEARCH_INDEX=

# TickerQ runs all schedules in UTC.
CRON_ENABLED=true
# Reserve this database exclusively for this deployment's TickerQ workers (not Redis Cluster).
TickerQ__RedisDatabase=1
# CRON_BACKUP= (overrides Cron:backup)
# CRON_RECOMMENDATION_DIGEST= (overrides Cron:recommendation-digest)
# CRON_SEARCH_RECONCILE= (overrides Cron:search-reconcile)
# CRON_INTEREST_PROFILES= (overrides Cron:interest-profiles)
