# Copy to .env. Keep credentials out of source control.
DATABASE_URL=postgresql://techlandier:local-dev-password@localhost:5433/techlandier
POSTGRES_DB=techlandier
POSTGRES_USER=techlandier
POSTGRES_PASSWORD=local-dev-password
POSTGRES_PORT=5433
APP_NAME=TechLandier
APP_BASE_URL=http://localhost:5199
DATA_DIR=storage
ANALYTICS_SALT=local-dev-salt

# External S3-compatible storage. Leave empty to run without uploads.
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_BACKUP_BUCKET=

EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=TechLandier

# TickerQ runs all schedules in UTC.
CRON_ENABLED=true
# CRON_BACKUP= (overrides Cron:backup)
