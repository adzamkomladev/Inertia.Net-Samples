# Copy to .env. Keep credentials out of source control.
DATABASE_URL=postgresql://techlandier:local-dev-password@localhost:5433/techlandier
APP_BASE_URL=http://localhost:5199
ANALYTICS_SALT=local-dev-salt

# Runwick dashboard sign-in. Defaults: Admin / Admin@12345 (local sample only; change outside development).
# RUNWICK_ADMIN_USERNAME=Admin
# RUNWICK_ADMIN_PASSWORD=Admin@12345

# S3-compatible object storage for uploads; keep the backup bucket private.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=uploads

EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
