{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=/data/app.db;Default Timeout=30;Foreign Keys=True"
  },
  "DataProtection": {
    "KeysPath": "/data/keys"
  },
  "App": {
    "Name": "Inkwell",
    "BaseUrl": "http://localhost:8080"
  },
  "Storage": {
    "ServiceUrl": "http://localhost:9000",
    "Region": "us-east-1",
    "AccessKey": "",
    "SecretKey": "",
    "MediaBucket": "media",
    "BackupBucket": "backups",
    "PublicBaseUrl": ""
  },
  "Email": {
    "ApiKey": "",
    "FromAddress": "no-reply@example.com",
    "FromName": "Inkwell"
  },
  "Jobs": {
    "Concurrency": 4
  }
}
