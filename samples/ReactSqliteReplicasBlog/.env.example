# Copy to .env in this sample directory. Existing process variables take precedence.
# Plain environment names are preferred; legacy ASP.NET section names also work. Never put secrets in VITE_ variables.
# For Docker use Data Source=/data/app.db so the database stays on the persistent volume.
DATABASE_URL=Data Source=storage/app.db;Default Timeout=30;Foreign Keys=True
DATA_PROTECTION_KEYS_PATH=storage/keys
APP_NAME=ReactSqliteReplicasBlog
APP_BASE_URL=http://localhost:8182
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1
S3_BUCKET=media
S3_BACKUP_BUCKET=backups
STORAGE_FORCED_PATH_STYLE=true
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=ReactSqliteReplicasBlog
ANALYTICS_SALT=local-dev-salt
JOBS_CONCURRENCY=4
# CRON_BACKUP="0 3 * * *"

# Optional overrides (UTC schedules):
# SSR_EXECUTABLE=bun
# CRON_ORPHAN_UPLOADS="0 * * * *"
# CRON_PRUNE="30 3 * * *"
# CRON_UNVERIFIED_USERS="0 4 * * *"
# CRON_WEEKLY_DIGEST="0 8 * * 1"

# SSR request timeout (seconds). Development defaults to 30; production to 5.
# SSR_TIMEOUT_SECONDS=30

# Optional services; folder/environment namespaces are enforced by the application.
SEARCH_DRIVER=native
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
REDIS_URL=

# Exact posts index UID; blank uses <sample>-<environment>-posts.
MEILISEARCH_INDEX=react_inertia_sqlite_multiple_replicas_production

# TickerQ runs all schedules in UTC.
CRON_ENABLED=true
# CRON_RECOMMENDATION_DIGEST= (overrides Cron:recommendation-digest)
# CRON_SEARCH_RECONCILE= (overrides Cron:search-reconcile)
# CRON_INTEREST_PROFILES= (overrides Cron:interest-profiles)

APP_PORT=8182
APP_BASE_URL_DOCKER=http://localhost:8182
REPLICA_NAMESPACE=ReactSqliteReplicasBlog:production
CACHE_NAMESPACE=ReactSqliteReplicasBlog-production
REDIS_PORT=6386
SECURE_COOKIES=false
Replicas__Enabled=true
DATA_DIR=storage
REDIS_URL_DOCKER=redis://redis:6379
DATABASE_URL_DOCKER=Data Source=/data/app.db;Default Timeout=30;Foreign Keys=True
